# Do not publish source/model-ready data without permission
/data/raw/*.csv
/data/raw/*.xlsx
/data/raw/*.xls
/data/raw/*.parquet
/data/processed/*.csv
/data/processed/*.xlsx
/data/processed/*.parquet

